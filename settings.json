{
  "workbench.iconTheme": "material-icon-theme",
  "workbench.productIconTheme": "Default",
  "workbench.colorTheme": "Dark+",
  "workbench.preferredDarkColorTheme": "Vim Deep Dark",
  "workbench.tree.indent": 14,
  "workbench.startupEditor": "none",
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.commandCenter": false,
  "workbench.layoutControl.enabled": false,
  "workbench.activityBar.location": "left",
  "workbench.statusBar.visible": true,
  "workbench.tips.enabled": false,
  "window.menuBarVisibility": "toggle",
  "window.titleBarStyle": "custom",

  "editor.fontFamily": "'JetBrains Mono', 'DejaVu Sans Mono', monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 22,
  "editor.fontLigatures": true,
  "editor.fontWeight": "450",
  "editor.fontVariations": true,
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": false,
  "breadcrumbs.enabled": false,
  "editor.renderWhitespace": "boundary",
  "editor.guides.bracketPairs": "active",
  "editor.bracketPairColorization.enabled": true,
  "editor.smoothScrolling": false,
  "editor.mouseWheelSmoothScroll": false,
  "editor.scrollBeyondLastLine": false,
  "editor.linkedEditing": true,
  "editor.rename.enablePreview": false,
  "editor.inlineSuggest.enabled": false,
  "github.copilot.nextEditSuggestions.enabled": false,
  "editor.suggestSelection": "first",
  "editor.snippetSuggestions": "top",
  "editor.detectIndentation": true,
  "editor.insertSpaces": true,
  "editor.trimAutoWhitespace": true,
  "editor.wordWrap": "off",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit",
  },

  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.simpleDialog.enable": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.exclude": {
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": true,
    "**/coverage": true,
    "**/dist": true,
    "**/.next": true,
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/coverage/**": true,
    "**/.cache/**": true,
  },

  "javascript.preferences.importModuleSpecifier": "relative",
  "typescript.preferences.importModuleSpecifier": "relative",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.tsserver.experimental.enableProjectDiagnostics": true,
  "javascript.suggest.autoImports": true,
  "typescript.suggest.autoImports": true,

  "explorer.compactFolders": true,
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": false,
  "search.useIgnoreFiles": true,
  "search.smartCase": true,

  "terminal.integrated.fontFamily": "'JetBrains Mono', monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.defaultLocation": "view",
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.suggest.enabled": true,
  "terminal.integrated.suggest.quickSuggestions": {
    "commands": "on",
    "arguments": "on",
    "unknown": "on",
  },
  "terminal.integrated.suggest.suggestOnTriggerCharacters": true,
  "terminal.integrated.suggest.selectionMode": "partial",
  "terminal.integrated.suggest.insertTrailingSpace": true,
  "terminal.integrated.suggest.showStatusBar": true,
  "terminal.integrated.stickyScroll.enabled": true,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.rightClickBehavior": "copyPaste",
  "terminal.integrated.enablePersistentSessions": true,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.tabs.location": "right",
  "terminal.integrated.gpuAcceleration": "auto",

  "git.autofetch": true,
  "git.confirmSync": true,
  "git.enableSmartCommit": false,
  "git.openRepositoryInParentFolders": "always",
  "scm.diffDecorations": "overview",
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.hideUnchangedRegions.enabled": true,

  "eslint.format.enable": true,
  "eslint.useESLintClass": true,
  "errorLens.enabled": true,
  "errorLens.messageEnabled": true,
  "errorLens.statusBarMessageEnabled": true,
  "tailwindCSS.emmetCompletions": true,
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript",
    "vue": "html",
  },
  "todo-tree.ripgrep.ripgrep": "/snap/code/current/usr/share/code/resources/app/node_modules.asar.unpacked/@vscode/ripgrep-universal/bin/linux-x64/rg",
  "emmet.triggerExpansionOnTab": true,
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "typescript": "typescriptreact",
  },
  "prettier.requireConfig": false,
  "prettier.singleQuote": true,
  "prettier.trailingComma": "all",
  "prettier.semi": true,
  "prettier.printWidth": 100,
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[scss]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[vue]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  "security.workspace.trust.untrustedFiles": "prompt",
  "extensions.autoUpdate": "on",
  "settingsSync.ignoredExtensions": [
    "donjayamanne.githistory",
    "dsznajder.es7-react-js-snippets",
    "firsttris.vscode-jest-runner",
    "formulahendry.auto-rename-tag",
    "formulahendry.code-runner",
    "jannchie.codetime",
    "nowsci.glassit-linux",
    "nucllear.vscode-extension-auto-import",
    "pkief.material-icon-theme",
    "streetsidesoftware.code-spell-checker",
    "wakatime.vscode-wakatime",
    "wix.vscode-import-cost",
  ],
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js, ${capture}.d.ts",
    "package.json": "",
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "workbench.browser.showInTitleBar": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "workbench.navigationControl.enabled": false,
  "window.commandCenter": false,
  "terminal.integrated.initialHint": false,
}
